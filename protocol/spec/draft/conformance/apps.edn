[{:case/id :greenways.os.case/app-web-tab
  :case/type :app-manifest
  :input {:app/protocol :greenways-app/1
          :app/id :hara-playground
          :app/version "0.1.0"
          :app/publisher {:publisher/id :hara-lang :publisher/name "Hara Lang"}
          :app/name "Hara Playground"
          :app/description "Open the browser-native Hara playground."
          :app/category :installable
          :app/capabilities [:hara/evaluate :tabs/open]
          :app/launch {:launch/handler :web-tab
                       :launch/url "https://playground.hara-lang.org/"}}
  :expect :valid}

 {:case/id :greenways.os.case/app-native-companion
  :case/type :app-manifest
  :input {:app/protocol :greenways-app/1
          :app/id :historia
          :app/version "0.1.0"
          :app/publisher {:publisher/id :greenways-ai :publisher/name "Greenways AI"}
          :app/name "Historia"
          :app/description "Collect AI conversation history locally."
          :app/category :installable
          :app/capabilities [:historia/import :network/loopback :tabs/open]
          :app/launch {:launch/handler :native-hybrid
                       :launch/url "http://127.0.0.1:4319/"}
          :app/requirement {:requirement/kind :companion
                            :requirement/id :historia-local
                            :requirement/name "Historia local companion"
                            :requirement/description "Must be installed and listening on 127.0.0.1:4319."}}
  :expect :valid}

 {:case/id :greenways.os.case/app-remote-module
  :case/type :app-manifest
  :input {:app/protocol :greenways-app/1
          :app/id :remote-app
          :app/version "0.1.0"
          :app/publisher {:publisher/id :bad-actor :publisher/name "Bad Actor"}
          :app/name "Remote app"
          :app/description "Attempts to provide remote code."
          :app/category :installable
          :app/capabilities [:tabs/open]
          :app/launch {:launch/handler :web-tab
                       :launch/url "https://playground.hara-lang.org/"
                       :launch/module "https://example.invalid/app.js"}}
  :expect {:error :remote-code-field-forbidden}}

 {:case/id :greenways.os.case/app-unsafe-url
  :case/type :app-manifest
  :input {:app/protocol :greenways-app/1
          :app/id :unsafe-app
          :app/version "0.1.0"
          :app/publisher {:publisher/id :bad-actor :publisher/name "Bad Actor"}
          :app/name "Unsafe app"
          :app/description "Attempts an unsafe launch."
          :app/category :installable
          :app/capabilities [:tabs/open]
          :app/launch {:launch/handler :web-tab
                       :launch/url "javascript:alert(1)"}}
  :expect {:error :launch-url-not-allowlisted}}

 {:case/id :greenways.os.case/app-missing-companion
  :case/type :app-manifest
  :input {:app/protocol :greenways-app/1
          :app/id :historia
          :app/version "0.1.0"
          :app/publisher {:publisher/id :greenways-ai :publisher/name "Greenways AI"}
          :app/name "Historia"
          :app/description "Omits its local companion."
          :app/category :installable
          :app/capabilities [:historia/import :network/loopback :tabs/open]
          :app/launch {:launch/handler :native-hybrid
                       :launch/url "http://127.0.0.1:4319/"}}
  :expect {:error :companion-requirement-required}}

 {:case/id :greenways.os.case/app-unknown-surface
  :case/type :app-manifest
  :input {:app/protocol :greenways-app/1
          :app/id :unknown-connector
          :app/version "0.1.0"
          :app/publisher {:publisher/id :bad-actor :publisher/name "Bad Actor"}
          :app/name "Unknown connector"
          :app/description "Requests a surface not shipped by Greenways OS."
