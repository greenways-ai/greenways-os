 {:case/id :greenways.os.case/app-invalid-publisher
  :case/type :app-manifest
  :input {:app/protocol :greenways-app/1
          :app/id :hara-playground
          :app/version "0.1.0"
          :app/publisher {:publisher/name "Unidentified publisher"}
          :app/name "Hara Playground"
          :app/description "Omits the stable publisher identifier."
          :app/category :installable
          :app/capabilities [:hara/evaluate :tabs/open]
          :app/launch {:launch/handler :web-tab
                       :launch/url "https://playground.hara-lang.org/"}}
  :expect {:error :publisher-id-required}}

 {:case/id :greenways.os.case/app-native-missing-tabs
  :case/type :app-manifest
  :input {:app/protocol :greenways-app/1
          :app/id :historia
          :app/version "0.1.0"
          :app/publisher {:publisher/id :greenways-ai :publisher/name "Greenways AI"}
          :app/name "Historia"
          :app/description "Omits the browser-tab capability used for launch."
          :app/category :installable
          :app/capabilities [:historia/import :network/loopback]
          :app/launch {:launch/handler :native-hybrid
                       :launch/url "http://127.0.0.1:4319/"}
          :app/requirement {:requirement/kind :companion
                            :requirement/id :historia-local
                            :requirement/name "Historia local companion"
                            :requirement/description "Must be installed locally."}}
  :expect {:error :launch-capability-required
           :capability :tabs/open}}

