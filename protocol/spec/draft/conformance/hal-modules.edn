[{:case/id :greenways.os.case/hal-module-release
  :case/type :app-manifest
  :input {:app/protocol :greenways-app/0-alpha
          :app/id :greenways-notes
          :app/version "1.2.0"
          :app/publisher {:publisher/id :greenways-ai
                          :publisher/name "Greenways AI"}
          :app/name "Notes"
          :app/description "A bounded HAL notes application."
          :app/category :installable
          :app/capabilities [:hara/module :storage/local]
          :app/launch {:launch/handler :hal-module}
          :app/kind :hal-module
          :app/channel :release
          :app/lock-digest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          :app/source {:source/kind :registry
                       :source/registry "https://packages.greenways.ai/"
                       :source/coordinate "greenways:notes"}}
  :expect :valid}

