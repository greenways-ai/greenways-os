   {"protocol" CORE-SERVICE-PROTOCOL
    "id" "surfaces"
    "name" "Surface and Interaction Host"
    "version" "0.1.0"
    "status" "active"
    "resident" true
    "removable" false
    "dependencies" ["kernel" "capabilities"]}
   {"protocol" CORE-SERVICE-PROTOCOL
    "id" "receipts"
