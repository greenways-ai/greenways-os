    "id" "kernel"
    "name" "Kernel and Module Runtime"
    "version" "0.1.0"
    "status" "active"
    "resident" true
    "removable" false
    "dependencies" []}
   {"protocol" CORE-SERVICE-PROTOCOL
    "id" "store"
    "name" "Durable State Store"
    "version" "0.1.0"
    "status" "active"
    "resident" true
    "removable" false
    "dependencies" ["kernel"]}
   {"protocol" CORE-SERVICE-PROTOCOL
    "id" "capabilities"
    "name" "Capability and Consent"
    "version" "0.1.0"
    "status" "active"
    "resident" true
    "removable" false
    "dependencies" ["kernel" "store"]}
   {"protocol" CORE-SERVICE-PROTOCOL
    "id" "identity"
    "name" "Identity"
    "version" "0.1.0"
    "status" "active"
    "resident" true
    "removable" false
    "dependencies" ["store" "capabilities"]}
   {"protocol" CORE-SERVICE-PROTOCOL
    "id" "keyring"
    "name" "Keyring"
    "version" "0.1.0"
    "status" "active"
    "resident" true
    "removable" false
    "dependencies" ["identity" "store" "capabilities"]}
   {"protocol" CORE-SERVICE-PROTOCOL
    "id" "packages"
    "name" "Package Lifecycle and Trust"
    "version" "0.1.0"
    "status" "active"
    "resident" true
    "removable" false
