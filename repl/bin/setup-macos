#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
GREENWAYS_HOME="${GREENWAYS_HOME:-$HOME/.greenways}"
CREDENTIAL="${GREENWAYS_DEVELOPER_CREDENTIAL:-$GREENWAYS_HOME/clients/developer.json}"
APP_SOURCE="$ROOT/apps/greenways_desktop/build/macos/Build/Products/Release/Greenways Desktop.app"
APP_DESTINATION="/Applications/Greenways Desktop.app"
SERVICE="gui/$(id -u)/ai.greenways.greenwaysd"
APPLY=0
DAEMON_STOPPED=0

usage() {
  cat <<'USAGE'
Usage: repl/bin/setup-macos [--apply]

Without --apply, performs every toolchain, installation, credential, and service
preflight without changing installed state. --apply builds and installs the app,
issues a dedicated developer credential only when the preflight proves that no
valid, orphaned, wrong-role, unsafe, or duplicate developer state exists, then
relaunches and verifies the daemon and Desktop control channel.
USAGE
}

while (($#)); do
  case "$1" in
    --apply) APPLY=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "setup-macos: unsupported argument: $1" >&2; exit 2 ;;
  esac
  shift
done

fail() {
  echo "setup-macos: $*" >&2
  exit 2
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required"
}

restore_daemon() {
  if ((DAEMON_STOPPED)); then
    launchctl kickstart -k "$SERVICE" >/dev/null 2>&1 || true
    DAEMON_STOPPED=0
  fi
}
trap restore_daemon EXIT INT TERM

[[ "$(uname -s)" == "Darwin" ]] || fail "this setup command supports macOS only"
for command in cargo rustc flutter dart hara jq python3 launchctl open osascript ditto stat codesign; do
  require_command "$command"
done

FLUTTER_VERSION="$(flutter --version --machine | jq -r '.frameworkVersion')"
DART_VERSION="$(dart --version 2>&1 | sed -E 's/^Dart SDK version: ([0-9]+\.[0-9]+\.[0-9]+).*/\1/')"
[[ "$FLUTTER_VERSION" == "3.47.0" ]] || \
  fail "Flutter 3.47.0 is required before mutation; found $FLUTTER_VERSION"
python3 - "$DART_VERSION" <<'PY' || exit 2
import sys
version = tuple(int(part) for part in sys.argv[1].split(".")[:3])
if version < (3, 13, 0):
    print(f"setup-macos: Dart 3.13.0 or newer is required; found {sys.argv[1]}", file=sys.stderr)
    raise SystemExit(2)
PY
rustc +1.85.1 --version >/dev/null 2>&1 || \
  fail "the pinned Rust 1.85.1 toolchain is required"

[[ -d "$GREENWAYS_HOME" ]] || fail "$GREENWAYS_HOME must already exist"
[[ ! -L "$GREENWAYS_HOME" ]] || fail "GREENWAYS_HOME may not be a symlink"
[[ "$(stat -f '%u' "$GREENWAYS_HOME")" == "$(id -u)" ]] || \
  fail "GREENWAYS_HOME must be owned by the current user"
launchctl print "$SERVICE" >/dev/null 2>&1 || \
  fail "ai.greenways.greenwaysd is not installed in the current GUI domain"

CURRENT_CLI=""
if [[ -x "$APP_DESTINATION/Contents/Resources/greenways" ]]; then
  CURRENT_CLI="$APP_DESTINATION/Contents/Resources/greenways"
elif command -v greenways >/dev/null 2>&1; then
  CURRENT_CLI="$(command -v greenways)"
else
  fail "an installed Greenways CLI is required for non-mutating preflight"
fi

"$CURRENT_CLI" status --home "$GREENWAYS_HOME" --json >/dev/null || \
  fail "greenwaysd must be live before setup preflight"

python3 - "$GREENWAYS_HOME" "$CREDENTIAL" <<'PY'
import os
import stat
import sys
from pathlib import Path

home = Path(sys.argv[1])
credential = Path(sys.argv[2])
if not credential.is_absolute():
    print("setup-macos: the developer credential path must be absolute", file=sys.stderr)
    raise SystemExit(2)
try:
    relative = credential.relative_to(home)
except ValueError:
    print("setup-macos: the developer credential must remain inside GREENWAYS_HOME", file=sys.stderr)
    raise SystemExit(2)
current = home
for part in relative.parent.parts:
    current = current / part
    if not os.path.lexists(current):
        continue
    metadata = os.lstat(current)
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        print(f"setup-macos: unsafe credential directory component: {current}", file=sys.stderr)
        raise SystemExit(2)
    if metadata.st_uid != os.getuid():
        print(f"setup-macos: credential directory is not current-user owned: {current}", file=sys.stderr)
        raise SystemExit(2)
    if stat.S_IMODE(metadata.st_mode) != 0o700:
        print(f"setup-macos: credential directory must be mode 0700: {current}", file=sys.stderr)
        raise SystemExit(2)
PY

ADMIN_LIST="$(cargo +1.85.1 run --quiet -p greenways-admin -- \
  client list --home "$GREENWAYS_HOME" --json)" || \
  fail "could not inspect local client state"
ACTIVE_DEVELOPERS="$(jq '[.[] | select(.role == "developer" and .revokedAtUnixMs == null)] | length' \
  <<<"$ADMIN_LIST")"
HARA_REPL_CLIENTS="$(jq '[.[] | select(.label == "Hara REPL" and .revokedAtUnixMs == null)] | length' \
  <<<"$ADMIN_LIST")"

ISSUE_CREDENTIAL=0
if [[ -e "$CREDENTIAL" || -L "$CREDENTIAL" ]]; then
  [[ ! -L "$CREDENTIAL" && -f "$CREDENTIAL" ]] || \
    fail "the developer credential path is not one regular file"
  [[ "$(stat -f '%u:%Lp' "$CREDENTIAL")" == "$(id -u):600" ]] || \
    fail "the developer credential must be current-user mode 0600"
  WHOAMI="$($CURRENT_CLI whoami --credential "$CREDENTIAL" \
    --home "$GREENWAYS_HOME" --json)" || \
    fail "the existing developer credential is orphaned or inactive"
  jq -e '.outcome == "ok" and .value.role == "developer"' \
    <<<"$WHOAMI" >/dev/null || \
    fail "the existing credential has the wrong role"
  CLIENT_ID="$(jq -er '.value.id' <<<"$WHOAMI")" || \
    fail "the existing developer credential did not identify its client"
  MATCHING_CLIENTS="$(jq --arg id "$CLIENT_ID" \
    '[.[] | select(.id == $id and .role == "developer" and .revokedAtUnixMs == null)] | length' \
    <<<"$ADMIN_LIST")"
  OTHER_HARA_REPL_CLIENTS="$(jq --arg id "$CLIENT_ID" \
    '[.[] | select(.label == "Hara REPL" and .revokedAtUnixMs == null and .id != $id)] | length' \
    <<<"$ADMIN_LIST")"
  [[ "$ACTIVE_DEVELOPERS" == "1" && "$MATCHING_CLIENTS" == "1" ]] || \
    fail "duplicate or orphaned developer client state exists"
  [[ "$OTHER_HARA_REPL_CLIENTS" == "0" ]] || \
    fail "duplicate Hara REPL client state exists"
  echo "setup-macos: preserving the valid developer credential at $CREDENTIAL"
else
  [[ "$ACTIVE_DEVELOPERS" == "0" ]] || \
    fail "an active developer client exists without this credential; refusing orphan replacement"
  [[ "$HARA_REPL_CLIENTS" == "0" ]] || \
    fail "duplicate Hara REPL client state exists"
  [[ ! -e "$CREDENTIAL" && ! -L "$CREDENTIAL" ]] || \
    fail "the credential output path is unsafe"
  ISSUE_CREDENTIAL=1
fi
if ((APPLY == 0)); then
  echo "setup-macos: all preflight checks passed; rerun with --apply to mutate installed state"
  exit 0
fi

cargo +1.85.1 build --release -p greenways-cli -p greenways-admin
(
  cd "$ROOT/apps/greenways_desktop"
  tool/build_macos.sh
)
[[ -d "$APP_SOURCE" ]] || fail "the release Desktop app was not produced"
BUNDLED_CLI="$APP_SOURCE/Contents/Resources/greenways"
[[ -x "$BUNDLED_CLI" ]] || fail "the release app does not contain the packaged greenways CLI"
"$BUNDLED_CLI" --version >/dev/null
codesign --verify --deep --strict "$APP_SOURCE"

osascript -e 'tell application "Greenways Desktop" to quit' >/dev/null 2>&1 || true
for _ in {1..40}; do
  [[ "$(osascript -e 'application "Greenways Desktop" is running' 2>/dev/null || echo false)" == "false" ]] && break
  sleep 0.25
done
[[ "$(osascript -e 'application "Greenways Desktop" is running' 2>/dev/null || echo false)" == "false" ]] || \
  fail "Greenways Desktop did not quit cleanly"
if [[ -e "$APP_DESTINATION" || -L "$APP_DESTINATION" ]]; then
  [[ -d "$APP_DESTINATION" && ! -L "$APP_DESTINATION" ]] || \
    fail "the installed Desktop path is unsafe"
  rm -rf "$APP_DESTINATION"
fi
ditto "$APP_SOURCE" "$APP_DESTINATION"
codesign --verify --deep --strict "$APP_DESTINATION"
INSTALLED_CLI="$APP_DESTINATION/Contents/Resources/greenways"
[[ -x "$INSTALLED_CLI" ]] || fail "the installed app is missing its packaged CLI"

if ((ISSUE_CREDENTIAL)); then
  mkdir -p "$(dirname "$CREDENTIAL")"
  chmod 0700 "$(dirname "$CREDENTIAL")"
  launchctl kill SIGTERM "$SERVICE" >/dev/null
  DAEMON_STOPPED=1
  for _ in {1..40}; do
    [[ ! -S "$GREENWAYS_HOME/run/greenwaysd.sock" ]] && break
    sleep 0.25
  done
  [[ ! -S "$GREENWAYS_HOME/run/greenwaysd.sock" ]] || \
    fail "greenwaysd did not stop cleanly"
  "$ROOT/target/release/greenways-admin" client issue \
    --role developer --label "Hara REPL" --output "$CREDENTIAL" \
    --home "$GREENWAYS_HOME" --json >/dev/null
  [[ ! -L "$CREDENTIAL" && -f "$CREDENTIAL" ]] || \
    fail "developer credential issuance did not produce one regular file"
  chmod 0600 "$CREDENTIAL"
fi

launchctl kickstart -k "$SERVICE" >/dev/null
DAEMON_STOPPED=0
open "$APP_DESTINATION"
for _ in {1..60}; do
  if "$INSTALLED_CLI" status --home "$GREENWAYS_HOME" --json >/dev/null 2>&1 && \
     "$INSTALLED_CLI" desktop status --home "$GREENWAYS_HOME" --json >/dev/null 2>&1; then
    break
  fi
  sleep 0.25
done

WHOAMI="$($INSTALLED_CLI whoami --credential "$CREDENTIAL" \
  --home "$GREENWAYS_HOME" --json)"
jq -e '.outcome == "ok" and .value.role == "developer"' \
  <<<"$WHOAMI" >/dev/null || fail "installed daemon did not authenticate the developer client"
DESKTOP="$($INSTALLED_CLI desktop status --home "$GREENWAYS_HOME" --json)"
jq -e '.protocol == "greenways-desktop-connection-status/0-alpha" and (.state | type == "string")' \
  <<<"$DESKTOP" >/dev/null || fail "Desktop did not return a live public snapshot"

echo "setup-macos: installed Greenways Desktop, packaged CLI, and verified the native Hara control workflow"
