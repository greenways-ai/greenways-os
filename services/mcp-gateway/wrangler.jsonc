{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greenways-mcp-gateway",
  "main": "src/cloudflare-worker.js",
  "compatibility_date": "2026-08-11",
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_REQUESTS",
        "class_name": "McpRequestDurableObject"
      },
      {
        "name": "MCP_PAIRINGS",
        "class_name": "McpPairingDurableObject"
      },
      {
        "name": "MCP_DELIVERIES",
        "class_name": "McpDeliveryDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["McpRequestDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["McpPairingDurableObject"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["McpDeliveryDurableObject"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
