(ns gw.os.kernel-test
  (:require [gw.os.kernel :as kernel]))

[(test-check "catalog search is case-insensitive across repository metadata"
              (vec (map (fn [entry] (get entry "name"))
                        (kernel/catalog-search
                         [{"name" "apartment"}
                          {"name" "splat-garden" "topics" ["gaussian-splat"]}]
                         "GARDEN")))
              ["splat-garden"])
  (test-check "Substrate exposes the portable application actions"
              (get (kernel/dispatch "world/open"
                                    ["https://github.com/greenways-worlds/apartment" "" "dev"])
                   "effects")
              [{"effect" "github"
                "method" "resolve-world"
                "args" ["https://github.com/greenways-worlds/apartment" "" "dev"]}])
  (test-check "application launch effects contain only the installed app id"
              (get (kernel/apps-open
                    (get (kernel/apps-install
                          (kernel/initial-state)
                          {"id" "historia"
                           "category" "installable"
                           "publisher" {"id" "greenways-ai"}
                           "capabilities" ["historia/import" "network/loopback" "tabs/open"]
                           "launch" {"handler" "native-hybrid"
                                     "url" "http://127.0.0.1:4319/"}})
                         "state")
                    "historia")
                   "effects")
              [{"effect" "browser"
                "method" "open-app"
                "args" ["historia"]}])
  (test-check "removing an installable app persists the remaining manifests"
              (get (kernel/apps-remove
                    (get (kernel/apps-restore
                          (kernel/initial-state)
                          [{"id" "greenways-home"
                            "category" "system"
                            "publisher" {"id" "greenways-ai"}
                            "capabilities" ["identity/local" "storage/local"]
                            "launch" {"handler" "extension-page"
                                      "path" "src/studio.html#home"}}
                           {"id" "historia"
                            "category" "installable"
                            "launch" {"handler" "web-tab"}}])
                         "state")
                    "historia")
                   "effects")
              [{"effect" "storage"
                "method" "save-apps"
                "args" [[{"id" "greenways-home"
                           "category" "system"
                           "publisher" {"id" "greenways-ai"}
                           "capabilities" ["identity/local" "storage/local"]
                           "launch" {"handler" "extension-page"
                                     "path" "src/studio.html#home"}}]]}])
  (test-check "active packaged apps own surface state and close when removed"
              (let [manifest {"id" "hestia-connector"
                              "category" "installable"
                              "publisher" {"id" "greenways-ai"}
                              "capabilities" ["hestia/connect" "network/https"
                                              "network/loopback" "storage/local"]
                              "launch" {"handler" "packaged-surface"
                                        "surfaceId" "hestia-connector"}}
                    installed (get (kernel/apps-install (kernel/initial-state) manifest)
                                   "state")
                    opened (get (kernel/apps-open installed "hestia-connector") "state")
                    removed (kernel/apps-remove opened "hestia-connector")]
                [(get (get opened "surface") "active")
                 (get (nth (get removed "effects") 1) "method")
                 (get (get (get removed "state") "apps") "active")
                 (get (get (get removed "state") "surface") "active")])
              ["hestia-connector" "close-surface" nil nil])
  (test-check "context restore rejects an orphan packaged surface"
              (let [restored
                    (kernel/app-restore
                     {"protocol" "greenways-kernel-context/0-alpha"
                      "apps" {"active" "hestia-connector"}
                      "surface" {"active" "hestia-connector"
                                 "payload" {"appId" "hestia-connector"}}
                      "studio" {"tracks" []}}
                     [])]
                [(get (get restored "apps") "active")
                 (get (get restored "surface") "active")])
              [nil nil])
  (test-check "reserved system ids are recognized independently of manifest data"
              [(kernel/system-app-id? "greenways-home")
               (kernel/system-app-id? "greenways-worlds")
               (kernel/system-app-id? "historia")]
              [true true false])
  (test-check "system capability bindings require the exact packaged set"
              [(kernel/exact-values? ["identity/local" "storage/local"]
                                     ["storage/local" "identity/local"])
               (kernel/exact-values? ["identity/local" "storage/local"]
                                     ["identity/local" "storage/local" "tabs/open"])]
              [true false])
  (test-check "generic workflows enforce transitions and roles"
              (get (kernel/workflow-transition
                    {"transitions" [{"id" "submit" "from" "draft" "to" "review"
                                      "roles" ["owner"]}]}
                    {"state" "draft" "history" []}
                    "submit" "owner" "2026-08-03T00:00:00Z")
                   "state")
              "review")
  (test-check "personal chain inclusion advances deterministically"
              (get (kernel/chain-include
                    "identity/1" {"sequence" 4 "eventHash" "sha256:prev"}
                    {"root" "sha256:action"} "2026-08-03T00:00:00Z" "sha256:event")
                   "sequence")
              5)]
