(ns gw.os.services-test
  (:require [gw.os.services :as services]
            [std.lib.test :as test]))

(test/print-results
 [(test/check
   "Tahto connector authority is split into connect, read and write grants"
   (vec
    (map
     (fn [id]
       (let [definition (services/capability-definition id)]
         [(get definition "service")
          (get definition "risk")
          (get definition "grantable")]))
     ["tahto/connect" "tahto/read" "tahto/write"]))
   [["connectors" "high" true]
    ["connectors" "medium" true]
    ["connectors" "critical" true]])

  (test/check
   "Hestia control authority is split across proposal, approval and execution"
   (vec
    (map
     (fn [id]
       (let [definition (services/capability-definition id)]
         [(get definition "service")
          (get definition "risk")
          (get definition "grantable")]))
     ["hestia/propose" "hestia/approve" "hestia/execute"]))
   [["work" "high" true]
    ["work" "critical" true]
    ["work" "critical" true]])

  (test/check
   "foreground model provision remains a reviewed surface capability"
   (let [definition (services/capability-definition "model/provide")]
     [(get definition "service")
      (get definition "risk")
      (get definition "grantable")
      (get definition "trustedPublishers")])
   ["surfaces" "critical" true ["greenways-ai"]])])
