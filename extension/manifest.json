{
  "manifest_version": 3,
  "name": "Greenways OS",
  "version": "0.4.0",
  "description": "A programmable browser operating system with a resident Hara kernel and preinstalled Kernel DevTools.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Greenways OS",
    "default_icon": {
      "16": "src/assets/icons/greenways-16.png",
      "32": "src/assets/icons/greenways-32.png"
    }
  },
  "icons": {
    "16": "src/assets/icons/greenways-16.png",
    "32": "src/assets/icons/greenways-32.png",
    "48": "src/assets/icons/greenways-48.png",
    "128": "src/assets/icons/greenways-128.png"
  },
  "side_panel": {
    "default_path": "src/launcher.html"
  },
  "permissions": [
    "sidePanel",
    "alarms",
    "storage",
    "nativeMessaging",
    "scripting",
    "userScripts"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://playground.hara-lang.org/*"],
      "js": ["dist/playground-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'none'"
  }
}
