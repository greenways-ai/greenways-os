{:schema "greenways.tripo-webapp-capabilities/0-alpha"
 :product :tripo-studio-web
 :verified-at "2026-08-17"
 :scope :panel-bound-tab-with-user-controlled-authentication
 :sources
 [{:id :tripo/studio
   :url "https://studio.tripo3d.ai/"}
  {:id :tripo/team-plan
   :url "https://www.tripo3d.ai/blog/tripo-turns-1-team-plan"}
  {:id :tripo/studio-tutorial
   :url "https://www.tripo3d.ai/blog/tripo-studio-tutorial-english"}
  {:id :tripo/openapi-introduction
   :url "https://docs.tripo3d.ai/get-started/introduction.html"}]
 :entities
 {:authentication
  {:identity [:tab-id]
   :snapshot [:state :signed-in? :origin :url :action
              :user-action-required? :credential-handling]}
  :workspace
  {:identity [:id]
   :snapshot [:name :mode :element]}
  :asset
  {:identity [:id :href]
   :snapshot [:title :href :status :visibility :workspace-id :active? :element]}
  :generation-draft
  {:identity [:workspace-id :mode]
   :snapshot [:prompt :input :model :topology :generate-in-parts?]}
  :generation-task
  {:identity [:task-id]
   :snapshot [:status :workspace-id :asset-id :credit-receipt]}}
 :operations
 [{:id :login-status :entity :authentication :phase 0 :effect :read :confirmation :none}
  {:id :login-start :entity :authentication :phase 0 :effect :navigation :confirmation :visible-user-action}
  {:id :login-wait :entity :authentication :phase 0 :effect :observe :confirmation :browser-completion}
  {:id :login :entity :authentication :phase 0 :effect :navigation-and-observe :confirmation :browser-completion}
  {:id :status :entity :page :phase 1 :effect :read :confirmation :none}
  {:id :workspace :entity :workspace :phase 1 :effect :read :confirmation :none}
  {:id :open-assets :entity :asset :phase 1 :effect :navigation :confirmation :none}
  {:id :assets :entity :asset :phase 1 :effect :read :confirmation :none}
  {:id :open-asset :entity :asset :phase 1 :effect :navigation :confirmation :none}
  {:id :draft-text-to-3d :entity :generation-draft :phase 2 :effect :local-ui :confirmation :explicit-prompt}
  {:id :draft-image-to-3d :entity :generation-draft :phase 2 :effect :local-file-selection :confirmation :explicit-source}
  {:id :generate :entity :generation-task :phase 3 :effect :credit-spending-write
   :confirmation [:workspace-id :confirm-credit-spend :maximum-credits]}
  {:id :segment :entity :asset :phase 4 :effect :credit-or-compute-write :confirmation :explicit-command}
  {:id :retopologize :entity :asset :phase 4 :effect :credit-or-compute-write :confirmation :explicit-command}
  {:id :texture :entity :asset :phase 4 :effect :credit-or-compute-write :confirmation :explicit-command}
  {:id :rig :entity :asset :phase 4 :effect :credit-or-compute-write :confirmation :explicit-command}
  {:id :stylize :entity :asset :phase 4 :effect :credit-or-compute-write :confirmation :explicit-command}
  {:id :export :entity :asset :phase 5 :effect :download
   :confirmation [:asset-id :format :destination]}
  {:id :team-members :entity :workspace :phase :deferred :effect :access-control-write :confirmation :separate-authority}
  {:id :buy-credits :entity :workspace :phase :deferred :effect :financial :confirmation :separate-authority}
  {:id :delete-asset :entity :asset :phase :deferred :effect :destructive
   :confirmation [:matching-title :matching-id]}]
 :selector-policy
 {:order [:stable-test-marker
          :aria-role-and-name
          :native-element-and-stable-href
          :visible-text-in-known-region]
  :forbidden [:hashed-css-class
              :position-only
              :private-api-as-authority]
  :ambiguity :fail-closed
  :unsupported-error :tripo/ui-unsupported}
 :authentication-policy
 {:credential-handling :browser-only
  :profile-storage :owner-only
  :provider-pages :do-not-inspect
  :credential-value-snapshots :forbidden
  :returned-url [:origin :pathname]
  :forbidden [:password :email-value :one-time-code :mfa-response :passkey-response
              :cookie :access-token :oauth-state :authorization-code]}
 :network-policy
 {:private-endpoints :unsupported
  :request-mutation :unsupported
  :capture-bodies? false
  :redact [:authorization :cookie :account :workspace :api-key]}
 :phases
 [{:id 0 :name :user-controlled-authentication}
  {:id 1 :name :workspace-and-assets}
  {:id 2 :name :generation-drafts}
  {:id 3 :name :generation-and-task-tracking}
  {:id 4 :name :refinement}
  {:id 5 :name :export}
  {:id :deferred :name :team-financial-and-destructive-authority}]}
